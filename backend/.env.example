# Backend environment variables — copy to `.env` and fill in.
# See docs/ARCHITECTURE.md §20 for the authoritative list.

# Application
FRONTEND_URL=http://localhost:3000

# Processing
MAX_CONCURRENT_JOBS=2
MAX_AUDIO_FILE_SIZE_MB=100
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
DOWNLOAD_TOTAL_TIMEOUT_SECONDS=60
RECONCILIATION_GRACE_PERIOD_SECONDS=120

# Temporary audio root (per-recording subdirs created under this)
TEMP_AUDIO_DIR=/tmp/voxa

# STT
# Options: "whisper" (dev), "google" (production)
STT_PROVIDER=whisper
WHISPER_MODEL=small

# Google STT (only required when STT_PROVIDER=google)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
